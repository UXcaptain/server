{
    "name": "user-research-platform",
    "engines": {
        "node": "22.x"
    },
    "description": "Back-end using an ExpressJS Server for User Research Platform",
    "main": "app.mjs",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "keywords": [],
    "license": "Proprietary",
    "author": "Sergio Navarro Redondo",
    "scripts": {
        "start": "node ./server/app.mjs",
        "start:local": "node --watch --env-file=.env ./server/app.mjs",
        "test:ui": "env $(cat .env | xargs) npx playwright test --ui",
        "test:noui": "env $(cat .env | xargs) npx playwright test",
        "docker:prod": "docker build --platform=linux/amd64 -t sergion14/uxmonkeys:server-latest . && docker push sergion14/uxmonkeys:server-latest",
        "docker:dev": "docker build --platform=linux/amd64 -t sergion14/uxmonkeys:server-next . && docker push sergion14/uxmonkeys:server-next"
    },
   
    "dependencies": {
        "@getbrevo/brevo": "^2.2.0",
        "@logtail/pino": "^0.5.0",
        "@prisma/client": "^6.5.0",
        "@quixo3/prisma-session-store": "^3.1.13",
        "axios": "^1.7.7",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^5.0.1",
        "express-session": "^1.18.0",
        "express-validator": "^7.2.1",
        "helmet": "^8.0.0",
        "mongodb": "^6.8.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pino": "^9.6.0",
        "pino-mongodb": "^4.3.0",
        "pino-pretty": "^13.0.0",
        "posthog-node": "^4.1.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.1",
        "@types/node": "^22.13.1",
        "eslint": "^8.57.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.31.0",
        "playwright": "^1.49.1",
        "prisma": "^6.5.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    },
    "directories": {
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/UXmonkeys/server"
    }    
}
