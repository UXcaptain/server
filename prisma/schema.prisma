// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../server/config/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_POSTGRES_CONNECTION_STRING")
  directUrl = env("PRISMA_POSTGRES_CONNECTION_DIRECT_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  role               userRoles @default(customer)
  created_at         DateTime  @default(now())
  last_updated_at    DateTime  @updatedAt
  last_login_at      DateTime?
  stripe_customer_id String?   @unique

  Subscription          Subscription[]
  Password_reset_tokens Password_reset_tokens[]
  Analysis              Analysis[]
  AnalysisRequests      AnalysisEntries[]

  @@index([id, email])
}

model Password_reset_tokens {
  id            String   @id @unique @default(uuid())
  user          User     @relation(fields: [user_id], references: [id])
  user_id       String
  token_expires DateTime
  created_at    DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

enum userRoles {
  customer
  admin
}

model Subscription {
  id      Int    @id @default(autoincrement())
  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  // Subscription information
  plan_name String
  status    String // active, refunded, cancelled

  // Timestamps - createdAt and updatedAt are automatically managed by Prisma
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, status])
}

model Analysis {
  id                         String            @id @default(uuid())
  owner                      User              @relation(fields: [owner_id], references: [id])
  owner_id                   String
  analysis_name              String
  analysis_tasks             Json
  analysis_url               String
  analysis_status            analysisStatus    @default(draft)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt
  current_participants_count Int               @default(0)
  max_number_of_participants Int
  analysis_requests          AnalysisEntries[]

  @@index([owner_id])
}

enum analysisStatus {
  draft // analysis has been created but not yet published
  published // analysis has been published and participants can join the analysis
  completed // analysis has been completed and no more participants are accepted
}

model AnalysisEntries {
  id           String                        @id @default(uuid())
  analysis     Analysis                      @relation(fields: [analysis_id], references: [id])
  analysis_id  String
  user         User                          @relation(fields: [user_id], references: [id])
  user_id      String
  status       analysisEntryCompletionStatus @default(in_progress)
  created_at   DateTime                      @default(now())
  updated_at   DateTime                      @updatedAt
  analysis_url String?

  @@index([created_at, status])
}

enum analysisEntryCompletionStatus {
  in_progress // participant has started the analysis
  cancelled // analysis has been started by the participant but not submitted in time - Serves to prevent the participant from participating AGAIN in the analysis
  submitted // participant has submitted the analysis by the user
  accepted // analysis has been accepted by the customer/admin and payment should be given
  rejected // analysis has been rejected by the customer/admin and payment should NOT be given
}
