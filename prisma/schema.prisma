generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_POSTGRES_CONNECTION_STRING")
  directUrl = env("PRISMA_POSTGRES_CONNECTION_DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  role            userRoles @default(customer)
  created_at      DateTime  @default(now())
  last_updated_at DateTime  @updatedAt
  last_login_at   DateTime?

  Analysis Analysis[]

  @@index([id, email])
}

model Password_reset_tokens {
  id            String   @id @unique @default(uuid())
  user_id       String
  token_expires DateTime
  created_at    DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

enum userRoles {
  customer
  admin
}

model Analysis {
  id                         String   @id @default(uuid())
  owner                      User     @relation(fields: [owner_id], references: [id])
  owner_id                   String
  analysis_name              String
  analysis_tasks             Json
  analysis_url               String
  analysis_status            analysisStatus @default(draft)
  created_at                 DateTime @default(now())
  max_number_of_participants Int

  @@index([id, owner_id])
}

enum analysisStatus {
  draft
  in_progress
  completed
}