// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../server/config/generated/prisma/client"
}

datasource db {
  provider = "postgresql"

  directUrl = env("PRISMA_POSTGRES_DIRECT_URL")
  url       = env("PRISMA_POSTGRES_CONNECTION_STRING")
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  password            String
  role                UserRoles
  created_at          DateTime              @default(now())
  last_updated_at     DateTime              @default(now()) @updatedAt
  last_login_at       DateTime?
  company_id          String
  Company             Company               @relation(fields: [company_id], references: [id])
  PasswordResetTokens PasswordResetTokens[]
  Analysis            Analysis[]
  ParticipantProfile  ParticipantProfile[]
  CustomerProfile     CustomerProfile[]
  utm_source          String?
  utm_medium          String?
  utm_campaign        String?
  utm_content         String?
  utm_term            String?
  gclid               String?
  fbclid              String?
}

model Company {
  id           String         @id @default(uuid())
  name         String?
  Analysis     Analysis[]
  User         User[]
  Subscription Subscription[]
  stripe_id    String?        @unique
  created_at   DateTime       @default(now())
  updated_at   DateTime       @default(now()) @updatedAt
}

model ParticipantProfile {
  id                    Int                   @id @default(autoincrement())
  name                  String?
  last_name             String?
  nif                   String? // Need to we can process payments
  payment_address       String?
  birth_date            DateTime?
  gender                Genders?
  country               Country?
  available_devices     DeviceType[]          @default([COMPUTER, MOBILE])
  education_level       EducationLevel?
  yearly_income         Int?
  parental_status       ParentalStatus?
  technical_proficiency TechnicalProficiency?
  approved              Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @default(now()) @updatedAt
  User                  User                  @relation(fields: [user_id], references: [id])
  user_id               String                @unique
  AnalysisEntry         AnalysisEntry[]
  ParticipantRating     ParticipantRating[]
}

model ParticipantRating {
  id                 Int                @id @default(autoincrement())
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
  participantProfile ParticipantProfile @relation(fields: [user_id], references: [id])
  user_id            Int                @unique
  score              Int
  AnalysisEntry      AnalysisEntry[]
}

model CustomerProfile {
  id           Int      @id @default(autoincrement())
  company_name String?
  position     String?
  User         User     @relation(fields: [user_id], references: [id])
  user_id      String   @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
}

model PasswordResetTokens {
  id            String   @id @unique @default(uuid())
  User          User     @relation(fields: [user_id], references: [id])
  user_id       String
  token_expires DateTime
  created_at    DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Subscription {
  id         String    @id @unique @default(uuid())
  company_id String    @unique
  Company    Company   @relation(fields: [company_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  expires_at DateTime?
}

model Analysis {
  id                         String                 @id @default(uuid())
  Company                    Company                @relation(fields: [owner_company_id], references: [id])
  owner_company_id           String
  device                     DeviceType
  name                       String
  scenario                   String?
  created_by                 String
  User                       User                   @relation(fields: [created_by], references: [id])
  tasks                      Json
  url                        String
  status                     AnalysisStatus         @default(draft)
  created_at                 DateTime               @default(now())
  updated_at                 DateTime               @default(now()) @updatedAt
  max_number_of_participants Int
  recruitment_type           RecruitmentType
  min_age                    Int
  max_age                    Int
  gender                     Genders
  country                    Country
  education_level            EducationLevel
  min_yearly_income          Int
  max_yearly_income          Int
  technical_proficiency      TechnicalProficiency
  parental_status            ParentalStatus
  AnalysisEntry              AnalysisEntry[]
  available_spots            Int

  @@index([owner_company_id]) // Not a unique field, but requires an index
}

model AnalysisEntry {
  id                     String                        @id @default(uuid())
  Analysis               Analysis                      @relation(fields: [analysis_id], references: [id])
  analysis_id            String
  ParticipantProfile     ParticipantProfile?           @relation(fields: [user_id], references: [user_id])
  user_id                String?
  status                 AnalysisEntryCompletionStatus @default(in_progress)
  created_at             DateTime                      @default(now())
  updated_at             DateTime                      @default(now()) @updatedAt
  transcription_segments Json?
  full_transcript        String?
  transcriptionJob       TranscriptionJob[]
  ratings                ParticipantRating?            @relation(fields: [ratingsId], references: [id])
  ratingsId              Int?

  @@index([analysis_id, status])
}

model TranscriptionJob {
  id                Int                    @id @unique @default(autoincrement())
  AnalysisEntry     AnalysisEntry          @relation(fields: [analysis_entry_id], references: [id])
  analysis_entry_id String
  status            TranscriptionJobStatus @default(PENDING)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @default(now()) @updatedAt
  language_code     String

  @@index([status])
}

enum TranscriptionJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Genders {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
  ANY
}

enum EducationLevel {
  NO_EDUCATION
  PRIMARY_EDUCATION
  SECONDARY_EDUCATION
  UNIVERSITY_DEGREE
  MASTERS_THESIS
  ANY
}

enum ParentalStatus {
  YES_CHILDREN
  NO_CHILDREN
  ANY
}

enum TechnicalProficiency {
  BASIC
  INTERMEDIATE
  EXPERT
  ANY
}

enum RecruitmentType {
  USER_PROVIDER
  PANEL_PROVIDED
}

enum UserRoles {
  customer
  admin
  participant
}

enum DeviceType {
  COMPUTER
  MOBILE
  TABLET
  ANY
}

enum Country {
  ES
  ANY
}

enum AnalysisStatus {
  draft // analysis has been created but not yet published
  published // analysis has been published and participants can join the analysis
  completed // analysis has been completed and no more participants are accepted
}

enum AnalysisEntryCompletionStatus {
  in_progress // participant has started the analysis
  cancelled // analysis has been started by the participant but not submitted in time - Serves to prevent the participant from participating AGAIN in the analysis
  submitted // participant has submitted the analysis by the user
  accepted // analysis has been accepted by the customer/admin and payment should be given
  rejected // analysis has been rejected by the customer/admin and payment should NOT be given
}
