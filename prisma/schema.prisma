// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../server/config/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_POSTGRES_CONNECTION_STRING")
  directUrl = env("PRISMA_POSTGRES_CONNECTION_DIRECT_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  role               UserRoles
  created_at         DateTime  @default(now())
  last_updated_at    DateTime  @default(now()) @updatedAt
  last_login_at      DateTime?
  stripe_customer_id String?

  Subscription          Subscription[]
  Password_reset_tokens Password_reset_tokens[]
  Analysis              Analysis[]
  Participants_profile  Participants_profile[]
  Customer_profile      Customer_profile[]
}

model Participants_profile {
  id               String            @id
  name             String?
  last_name        String?
  age              String? // String to allow for prefer not to say option
  gender           Genders?
  invited_by       String?
  country          String?
  devices          String[]          @default([])
  created_at       DateTime          @default(now())
  updated_at       DateTime          @default(now()) @updatedAt
  user             User              @relation(fields: [user_id], references: [id])
  user_id          String            @unique
  analysis_entries AnalysisEntries[]
}

model Customer_profile {
  id           String  @id
  company_name String?
  position     String?
  user         User    @relation(fields: [user_id], references: [id])
  user_id      String
}

model Password_reset_tokens {
  id            String   @id @unique @default(uuid())
  user          User     @relation(fields: [user_id], references: [id])
  user_id       String
  token_expires DateTime
  created_at    DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Subscription {
  id      String @id
  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  // Timestamps - createdAt and updatedAt are automatically managed by Prisma
  created_at DateTime @default(now())

  @@index([user_id])
}

model Analysis {
  id                         String            @id @default(uuid())
  owner                      User              @relation(fields: [owner_id], references: [id])
  owner_id                   String
  device                     AnalysisDevice
  name                       String
  scenario                   String
  tasks                      Json
  url                        String
  status                     analysisStatus    @default(draft)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @default(now()) @updatedAt
  max_number_of_participants Int
  entries                    AnalysisEntries[]

  @@index([owner_id]) // Not a unique field, but requires an index
}

model AnalysisEntries {
  id                  String                        @id @default(uuid())
  Analysis            Analysis                      @relation(fields: [analysis_id], references: [id])
  analysis_id         String
  Participants_profile Participants_profile          @relation(fields: [user_id], references: [user_id])
  user_id             String
  status              analysisEntryCompletionStatus @default(in_progress)
  created_at          DateTime                      @default(now())
  updated_at          DateTime                      @default(now()) @updatedAt
  url                 String?

  @@index([analysis_id, status])
}

enum Genders {
  male
  female
  prefer_not_to_say
}

enum UserRoles {
  customer
  admin
  participant
}

enum AnalysisDevice {
  computer
  mobile
  tablet
  other
}

enum analysisStatus {
  draft // analysis has been created but not yet published
  published // analysis has been published and participants can join the analysis
  completed // analysis has been completed and no more participants are accepted
}

enum analysisEntryCompletionStatus {
  in_progress // participant has started the analysis
  cancelled // analysis has been started by the participant but not submitted in time - Serves to prevent the participant from participating AGAIN in the analysis
  submitted // participant has submitted the analysis by the user
  accepted // analysis has been accepted by the customer/admin and payment should be given
  rejected // analysis has been rejected by the customer/admin and payment should NOT be given
}
